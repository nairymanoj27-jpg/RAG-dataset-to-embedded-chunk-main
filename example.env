# ---------------------------------------------------------------- Pinecone credentials
# Get your API key from https://app.pinecone.io -> "API Keys".
PINECONE_API_KEY=your-pinecone-api-key

# Optional. Leave BLANK and the SDK resolves the host from the index name
# (equivalent to pc.Index("<index-name>") in the Pinecone quickstart).
# Only set it to skip the lookup, e.g.
# https://my-index-abc1234.svc.aped-1234-5678.pinecone.io
PINECONE_HOST=

# ---------------------------------------------------------------- Pinecone settings
PINECONE_INDEX=donbosco
# Must be non-empty for "document" (integrated embedding) indexes.
PINECONE_NAMESPACE=default
# Used only for classic vector indexes. Document indexes embed with their own
# model configured in Pinecone.
PINECONE_EMBED_MODEL=multilingual-e5-large

# Only needed if the index does not exist yet and you want it created
# automatically on the first upload.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------------------------------------------------------------- Input files
# Used when no file path is passed on the command line.
PDF_PATH=Automatic accident detection and alert system .pdf
CSV_PATH=EPL_Match_Data_2000_2026.csv

# ---------------------------------------------------------------- Tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=100
